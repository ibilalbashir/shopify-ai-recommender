# ---- Shopify app credentials ----
# Create these by making a "Custom app" (or Public app) in your Shopify Partner Dashboard
# https://partners.shopify.com -> Apps -> Create app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated scopes the app needs
SHOPIFY_SCOPES=read_products,write_script_tags,read_script_tags

# The public HTTPS URL where THIS server is deployed (no trailing slash).
# During local dev, use an ngrok/cloudflared tunnel URL here.
HOST=https://your-app.onrender.com

# ---- Database ----
# Postgres connection string used to persist per-shop access tokens and the
# cached product catalog across restarts/redeploys. Recommended: a free
# Postgres database at https://neon.com (no credit card required, doesn't
# expire). Copy the connection string it gives you, e.g.:
# postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- Google Gemini ----
# Free API key, no credit card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated fallback chain, tried in order. Google's free-tier quotas
# and model availability shift often (a flagship model was seen throttled
# to 20 requests/day, and an older model was abruptly retired for new API
# keys with a 404). The app automatically falls back to the next model on
# quota exhaustion (429) or a retired/unavailable model (404), so listing
# more than one here adds real resilience. Flash-Lite models currently
# carry much higher free-tier daily quotas (~1,500/day) than flagship Flash
# models (as low as 20/day) — check https://ai.google.dev/gemini-api/docs/rate-limits
# or https://aistudio.google.com/rate-limit for current numbers if this
# breaks again.
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash

# ---- Admin (view what customers ask the bot) ----
# A password of your choosing (any random string). Visit
# https://your-app-host/admin/chats?key=THIS_VALUE to read through recent
# conversations and tune the prompt in src/services/gemini.js accordingly.
# Leave blank to disable the page. Keep this secret — anyone with the link
# and key can read customer chat logs.
ADMIN_SECRET=

# ---- Server ----
PORT=3000
